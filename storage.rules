rules_version = '2';

// Firebase Storage Security Rules for FastFood App
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read and write to the products folder
    match /products/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read and write to test folder (for connectivity tests)
    match /test/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Default rule: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
